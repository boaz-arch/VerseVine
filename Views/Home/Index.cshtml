@{
    ViewData["Title"] = "Home Page";
}


<div class="HomePageDiv">
    <h1 class="HomeTitle">How does it work?</h1>
    <p class="HomeText">
        The idea behind the website is to grow closer 
        to God and pray for each other by adding your 
        own info to the page: <br>
        <br>
        Adding verses:<br>
        - Go to the topic section.<br>
        - Click on "Add yours".<br>
        - Enetr a topic (must be from the list).<br>
        - Enetr a book, chapter and verse.<br>
        - Click on "Create"<br>
        <br>
        Add a prayer request:<br>
        - Go to the prayer section.<br>
        - Click on "Add yours".<br>
        - Type in your prayer request.<br>
        - Click on "Create"<br>

    </p>
</div>


