@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}
<div class="contentDiv2">

    <h1 class="logisticHeder">@ViewData["Title"]</h1>
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <hr />
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="SubmitSpacing">
                    <button type="submit" class="w-100 btn btn-lg btn-primary">Resend</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="CreatePageImage">
    <div class="Image">
        <center>
            <img src="~/image/image3.jpg" class="CreateNature2">
            <!-- Use image, image3, image5 -->
        </center>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
